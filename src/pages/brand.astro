---
// Brand reference sheet — not linked from the site, not indexed.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const colors = [
  { name: 'Cream', hex: '#FBF4EA', use: 'Background' },
  { name: 'Sand', hex: '#F3E3CF', use: 'Surfaces, cards' },
  { name: 'Cocoa', hex: '#3A2A22', use: 'Text, dark sections' },
  { name: 'Apricot', hex: '#E9945B', use: 'Sun, highlights' },
  { name: 'Terracotta', hex: '#C9603F', use: 'Accent, italics' },
  { name: 'Deep Terracotta', hex: '#A84A2D', use: 'Buttons, links' },
  { name: 'Sun Gold', hex: '#D9A441', use: 'Rays, details' },
  { name: 'Blush', hex: '#F2C4B3', use: 'Soft fills' },
];
---
<Base title="Sunnails Brand Guide" noindex>
  <main class="brand container">
    <header class="b-section">
      <p class="eyebrow">Brand guide</p>
      <Logo size="lg" tagline />
      <p class="lede">Mood: <strong>Golden Hour</strong>. Warm, sun-washed, soft and confident. Think late-afternoon light through a window and freshly polished nails catching it.</p>
    </header>

    <section class="b-section">
      <h2>Logo</h2>
      <div class="logos">
        <div class="logo-tile"><Logo size="lg" /></div>
        <div class="logo-tile logo-tile--dark"><Logo size="lg" /></div>
        <div class="logo-tile"><img src="/favicon.svg" alt="Sunnails icon" width="96" height="96" /></div>
      </div>
      <p class="note">The logo is a wordmark: "sun" upright, "nails" in terracotta italic, and the dot of the <em>i</em> drawn as a rising sun. Always write it as one lowercase word. Keep clear space equal to the height of the "s" on every side. The sun on its own works as the app/social icon.</p>
    </section>

    <section class="b-section">
      <h2>Colour</h2>
      <div class="swatches">
        {
          colors.map((c) => (
            <div class="swatch">
              <div class="chip" style={`background:${c.hex}`} />
              <strong>{c.name}</strong>
              <code>{c.hex}</code>
              <span>{c.use}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="b-section">
      <h2>Typography</h2>
      <div class="type">
        <div>
          <p class="label">Display: Fraunces (Soft), with italics for emphasis</p>
          <p class="t-display">Nails that <em>glow</em></p>
        </div>
        <div>
          <p class="label">Body / UI: Manrope</p>
          <p class="t-body">Gel, BIAB, nail art and slow, spa-style pedicures in a warm, sun-washed studio. Come in, sit back, leave glowing.</p>
        </div>
      </div>
    </section>

    <section class="b-section">
      <h2>Buttons &amp; voice</h2>
      <div class="buttons">
        <a class="btn" href="#">Book an appointment</a>
        <a class="btn btn--ghost" href="#">See services</a>
      </div>
      <ul class="voice">
        <li><strong>Warm, not fussy.</strong> "Come in, sit back, leave glowing."</li>
        <li><strong>Sun words, used lightly:</strong> glow, golden, sunshine, sunset.</li>
        <li><strong>Short sentences.</strong> Friendly, confident, never salesy.</li>
      </ul>
    </section>
  </main>
</Base>

<style>
  .brand {
    padding-block: 4rem 6rem;
  }
  .b-section {
    padding-block: 2.5rem;
    border-bottom: 1px dashed rgb(58 42 34 / 0.2);
  }
  header.b-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .b-section h2 {
    font-size: var(--step-2);
    margin-bottom: 1.5rem;
  }
  .lede {
    max-width: 38rem;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .logo-tile {
    display: grid;
    place-items: center;
    min-height: 180px;
    border-radius: var(--radius-lg);
    background: var(--sand);
  }
  .logo-tile--dark {
    background: var(--cocoa);
    color: var(--cream);
  }
  .note,
  .label {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1.25rem;
  }
  .swatch {
    display: grid;
    gap: 0.2rem;
    font-size: var(--step--1);
  }
  .swatch span {
    color: var(--text-muted);
  }
  .chip {
    aspect-ratio: 1;
    border-radius: 50% 50% 46% 46% / 62% 62% 38% 38%;
    box-shadow: inset 0 0 0 1px rgb(58 42 34 / 0.1), var(--shadow);
    margin-bottom: 0.6rem;
  }
  .type {
    display: grid;
    gap: 2rem;
  }
  .t-display {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'opsz' 144;
    font-size: var(--step-4);
    line-height: 1;
  }
  .t-display em {
    color: var(--terracotta);
  }
  .t-body {
    max-width: 36rem;
    font-size: var(--step-1);
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .voice {
    margin-top: 2rem;
    display: grid;
    gap: 0.6rem;
    padding-left: 1.2rem;
  }
</style>
