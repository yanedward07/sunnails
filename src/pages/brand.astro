---
// Brand reference sheet — not linked from the site, not indexed.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const colors = [
  { name: 'Frost', hex: '#F6FAF9', use: 'Background' },
  { name: 'Seafoam', hex: '#E3F1EE', use: 'Surfaces, cards' },
  { name: 'Deep Sea', hex: '#0F2E2E', use: 'Text, dark sections' },
  { name: 'Sea Glass', hex: '#2F8F83', use: 'Accent, italics' },
  { name: 'Deep Teal', hex: '#1D6B62', use: 'Buttons, links' },
  { name: 'Aqua', hex: '#7CCFC2', use: 'Highlights on dark' },
  { name: 'Mint', hex: '#BFE3DA', use: 'Soft fills' },
  { name: 'Coral', hex: '#F4B6B0', use: 'Tiny accents only' },
];
---
<Base title="Sunnails Brand Guide" noindex>
  <main class="brand container">
    <header class="b-section">
      <p class="eyebrow">Brand guide</p>
      <Logo size="lg" tagline />
      <p class="lede">Mood: <strong>Sea Glass</strong>. Fresh, calm and professional. Think cool water, frosted glass and clean white light: a breath of fresh air on Yonge Street.</p>
    </header>

    <section class="b-section">
      <h2>Logo</h2>
      <div class="logos">
        <div class="logo-tile"><Logo size="lg" /></div>
        <div class="logo-tile logo-tile--dark"><Logo size="lg" /></div>
        <div class="logo-tile"><img src="/favicon.svg" alt="Sunnails icon" width="96" height="96" /></div>
      </div>
      <p class="note">The logo is a wordmark: "Sun" upright, "Nails" in sea-glass teal italic, and the dot of the <em>i</em> drawn as a rising sun. The name is always written <strong>Sun Nails</strong>: two words, both capitalised. Keep clear space equal to the height of the "s" on every side. The sun on its own works as the app/social icon.</p>
    </section>

    <section class="b-section">
      <h2>Colour</h2>
      <div class="swatches">
        {
          colors.map((c) => (
            <div class="swatch">
              <div class="chip" style={`background:${c.hex}`} />
              <strong>{c.name}</strong>
              <code>{c.hex}</code>
              <span>{c.use}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="b-section">
      <h2>Typography</h2>
      <div class="type">
        <div>
          <p class="label">Display: Instrument Serif, with italics for emphasis</p>
          <p class="t-display">Relax, refresh, <em>renew</em></p>
        </div>
        <div>
          <p class="label">Body / UI: Inter Tight</p>
          <p class="t-body">Gel, BIAB, nail art and slow, spa-style pedicures in a warm, sun-washed studio. Come in, sit back, leave glowing.</p>
        </div>
      </div>
    </section>

    <section class="b-section">
      <h2>Buttons &amp; voice</h2>
      <div class="buttons">
        <a class="btn" href="#">Book an appointment</a>
        <a class="btn btn--ghost" href="#">See services</a>
      </div>
      <ul class="voice">
        <li><strong>Calm and confident.</strong> "Come in, sit back, leave glowing."</li>
        <li><strong>Fresh words, used lightly:</strong> fresh, clean, calm, breathe.</li>
        <li><strong>Short sentences.</strong> Friendly, confident, never salesy.</li>
      </ul>
    </section>
  </main>
</Base>

<style>
  .brand {
    padding-block: 4rem 6rem;
  }
  .b-section {
    padding-block: 2.5rem;
    border-bottom: 1px dashed rgb(var(--ink-rgb) / 0.2);
  }
  header.b-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .b-section h2 {
    font-size: var(--step-2);
    margin-bottom: 1.5rem;
  }
  .lede {
    max-width: 38rem;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .logo-tile {
    display: grid;
    place-items: center;
    min-height: 180px;
    border-radius: var(--radius-lg);
    background: var(--foam);
  }
  .logo-tile--dark {
    background: var(--ink);
    color: var(--frost);
  }
  .note,
  .label {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1.25rem;
  }
  .swatch {
    display: grid;
    gap: 0.2rem;
    font-size: var(--step--1);
  }
  .swatch span {
    color: var(--text-muted);
  }
  .chip {
    aspect-ratio: 1;
    border-radius: 50% 50% 46% 46% / 62% 62% 38% 38%;
    box-shadow: inset 0 0 0 1px rgb(var(--ink-rgb) / 0.1), var(--shadow);
    margin-bottom: 0.6rem;
  }
  .type {
    display: grid;
    gap: 2rem;
  }
  .t-display {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
  }
  .t-display em {
    color: var(--teal);
  }
  .t-body {
    max-width: 36rem;
    font-size: var(--step-1);
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .voice {
    margin-top: 2rem;
    display: grid;
    gap: 0.6rem;
    padding-left: 1.2rem;
  }
</style>
