---
import Photo from './Photo.astro';
import { interiorImages } from '../lib/images';

const shots = interiorImages.slice(0, 3);
const placeholders = ['Manicure bar', 'Nail art wall', 'Pedicure lounge'];
---
<section class="section space" id="space">
  <div class="container space__inner">
    <div class="space__copy">
      <p class="eyebrow" data-reveal>Our space</p>
      <h2 data-reveal style="--i:1">A little pocket of <em>sunshine</em> on Yonge.</h2>
      <p data-reveal style="--i:2">
        Bright manicure stations, a wall of colours and designs to choose from, and a cosy pedicure lounge with massage chairs and warm light. Step in off Yonge Street and take a breather.
      </p>
      <ul class="space__points" data-reveal style="--i:3">
        <li>Massage chairs in the pedicure lounge</li>
        <li>Hundreds of gel colours, chrome &amp; cat-eye finishes</li>
        <li>Nails, waxing, lashes, facials &amp; massage in one visit</li>
      </ul>
    </div>

    <div class="space__photos">
      {
        shots.length
          ? shots.map((s, i) => (
              <figure class={`shot shot--${i + 1}`} data-parallax={[0.06, -0.08, 0.1][i]}>
                <div data-reveal="polish" style={`--i:${i}`}>
                  <Photo src={s.src} alt={s.alt} sizes="(min-width: 900px) 30vw, 60vw" />
                </div>
              </figure>
            ))
          : placeholders.map((label, i) => (
              <figure class={`shot shot--${i + 1}`} data-parallax={[0.06, -0.08, 0.1][i]}>
                <div class="shot__ph" data-reveal="polish" style={`--i:${i}`}>
                  <span>{label}</span>
                </div>
              </figure>
            ))
      }
    </div>
  </div>
</section>

<style>
  .space {
    background: var(--sand);
    overflow: hidden;
  }
  .space__inner {
    display: grid;
    gap: 3.5rem;
  }
  .space h2 {
    font-size: var(--step-3);
    margin-bottom: 1.2rem;
  }
  .space__copy > p:not(.eyebrow) {
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 32rem;
  }
  .space__points {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 0.8rem;
    font-weight: 600;
  }
  .space__points li {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
  }
  .space__points li::before {
    content: '';
    flex: none;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--apricot);
    box-shadow: 0 0 0 4px rgb(233 148 91 / 0.25);
  }

  .space__photos {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: clamp(70px, 18vw, 120px);
    gap: 0.9rem;
  }
  .shot {
    margin: 0;
    will-change: transform;
  }
  .shot > div {
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shot--1 {
    grid-column: 1 / 5;
    grid-row: 1 / 4;
  }
  .shot--1 > div {
    --radius-lg: 999px 999px 36px 36px;
  }
  .shot--2 {
    grid-column: 4 / 7;
    grid-row: 3 / 6;
    z-index: 1;
  }
  .shot--3 {
    grid-column: 1 / 4;
    grid-row: 4 / 6;
  }
  .shot__ph {
    display: grid;
    place-items: end start;
    padding: 1rem 1.2rem;
    background:
      radial-gradient(80% 70% at 75% 20%, rgb(255 236 200 / 0.9), transparent 60%),
      linear-gradient(160deg, var(--blush), var(--apricot) 70%, var(--terracotta));
    color: var(--white);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
  }
  .shot--2 .shot__ph {
    background:
      radial-gradient(70% 60% at 30% 25%, rgb(255 240 210 / 0.9), transparent 60%),
      linear-gradient(200deg, var(--sand-deep), var(--gold) 90%);
  }
  .shot--3 .shot__ph {
    background:
      radial-gradient(70% 60% at 70% 30%, rgb(255 230 220 / 0.8), transparent 60%),
      linear-gradient(140deg, var(--blush), var(--cocoa-soft));
  }

  @media (min-width: 900px) {
    .space__inner {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: 5rem;
    }
    .space__photos {
      grid-auto-rows: 110px;
    }
  }
</style>

<script>
  const items = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let ticking = false;

  const update = () => {
    const vh = window.innerHeight;
    items.forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.bottom < -200 || r.top > vh + 200) return;
      const offset = (r.top + r.height / 2 - vh / 2) * Number(el.dataset.parallax);
      el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
    });
    ticking = false;
  };

  if (!reduce.matches && items.length) {
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
