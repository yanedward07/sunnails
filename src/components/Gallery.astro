---
import Photo from './Photo.astro';
import { nailImages } from '../lib/images';
import { site } from '../data/site';

// Desktop masonry: split the photos across 3 columns so the columns end as level as possible.
// On phones the columns use `display: contents`, and `order` restores the original sequence for the swipe carousel.
const COLS = 3;
const GAP = 0.05; // gap between tiles, as a fraction of column width
const sizes = nailImages.map((img) => img.src.height / img.src.width + GAP);

// Greedy "shortest column" placement; for small galleries, search every split for the most even one.
const greedy = () => {
  const h = Array(COLS).fill(0);
  return sizes.map((sz) => {
    const c = h.indexOf(Math.min(...h));
    h[c] += sz;
    return c;
  });
};
const spread = (assign: number[]) => {
  const h = Array(COLS).fill(0);
  assign.forEach((c, i) => (h[c] += sizes[i]));
  return Math.max(...h) - Math.min(...h);
};
let best = greedy();
if (sizes.length <= 13) {
  let bestSpread = spread(best);
  const assign: number[] = [];
  const search = (i: number) => {
    if (i === sizes.length) {
      const sp = spread(assign);
      if (sp < bestSpread) [bestSpread, best] = [sp, [...assign]];
      return;
    }
    for (let c = 0; c < COLS; c++) {
      // first photo stays top-left, and columns are only opened in order (skips mirror-image splits)
      if (c > Math.max(-1, ...assign.slice(0, i)) + 1 || (i === 0 && c > 0)) break;
      assign[i] = c;
      search(i + 1);
    }
  };
  search(0);
}

const columns: { img: (typeof nailImages)[number]; index: number }[][] = Array.from({ length: COLS }, () => []);
nailImages.forEach((img, index) => columns[best[index]].push({ img, index }));
---
<section class="section gallery" id="gallery">
  <div class="container">
    <div class="gallery__head">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Gallery</p>
        <h2 data-reveal style="--i:1">Chrome, cat eye <em>&amp;</em> more</h2>
      </div>
      {
        site.instagram && (
          <a class="gallery__ig" href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener" data-reveal style="--i:2">
            More on Instagram @{site.instagram} ↗
          </a>
        )
      }
    </div>

    <div class="grid" role="list" data-gallery>
      {
        columns.map((col, c) => (
          <div class="col">
            {col.map(({ img, index }) => (
              <div class="tile" role="listitem" style={`order:${index}`}>
                <button class="tile__btn" data-index={index} data-reveal="polish" style={`--i:${c}`} aria-label={`Open photo: ${img.alt}`}>
                  <Photo src={img.src} alt={img.alt} sizes="(min-width: 1100px) 380px, (min-width: 768px) 33vw, 75vw" />
                </button>
              </div>
            ))}
          </div>
        ))
      }
    </div>
    <p class="gallery__hint" aria-hidden="true">Swipe <span>→</span></p>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <img alt="" data-lightbox-img />
    <button class="lightbox__close" data-lightbox-close aria-label="Close">✕</button>
    <button class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Previous photo">←</button>
    <button class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Next photo">→</button>
  </dialog>
</section>

<style>
  .gallery__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0 2rem;
  }
  .gallery__ig {
    font-weight: 700;
    color: var(--ink);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    text-underline-offset: 4px;
  }

  /* mobile: swipeable carousel */
  .grid {
    list-style: none;
    margin: 0 calc(-1 * var(--gutter));
    padding: 0.5rem var(--gutter) 1rem;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .grid::-webkit-scrollbar {
    display: none;
  }
  .col {
    display: contents;
  }
  .tile {
    flex: 0 0 72%;
    scroll-snap-align: start;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .tile:nth-child(odd) {
    --radius-lg: 999px 999px 36px 36px;
  }
  .tile__btn {
    --radius-lg: inherit;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--mist);
    cursor: zoom-in;
  }
  .tile :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .tile__btn:hover :global(img) {
    transform: scale(1.05);
  }
  .gallery__hint {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .gallery__hint span {
    display: inline-block;
    animation: nudge 1.6s var(--ease) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateX(6px);
    }
  }

  /* desktop: masonry */
  @media (min-width: 768px) {
    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    .col {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .tile {
      flex: none;
    }
    /* last photo in each column stretches a touch so all three columns end flush */
    .col > .tile:last-child {
      flex: 1;
    }
    .col > .tile:last-child .tile__btn,
    .col > .tile:last-child :global(picture) {
      height: 100%;
    }
    .col > .tile:last-child :global(img) {
      height: 100%;
      object-fit: cover;
    }
    .tile :global(img) {
      aspect-ratio: auto;
    }
    .gallery__hint {
      display: none;
    }
  }

  /* lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(var(--ink-rgb) / 0.92);
    display: none;
    place-items: center;
  }
  .lightbox[open] {
    display: grid;
    animation: fade 0.35s var(--ease);
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox img {
    max-width: min(92vw, 900px);
    max-height: 82dvh;
    width: auto;
    border-radius: var(--radius);
    object-fit: contain;
  }
  .lightbox button {
    position: absolute;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    font-size: 1.3rem;
    cursor: pointer;
  }
  .lightbox__close {
    top: calc(1rem + env(safe-area-inset-top));
    right: 1rem;
  }
  .lightbox__nav {
    bottom: calc(1.5rem + env(safe-area-inset-bottom));
  }
  .lightbox__nav--prev {
    left: calc(50% - 64px);
  }
  .lightbox__nav--next {
    right: calc(50% - 64px);
  }
  @media (min-width: 768px) {
    .lightbox__nav {
      bottom: auto;
      top: 50%;
      translate: 0 -50%;
    }
    .lightbox__nav--prev {
      left: 2rem;
    }
    .lightbox__nav--next {
      right: 2rem;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const big = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
  // DOM order is column-by-column, so sort back into the original photo order
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery] [data-index]')].sort(
    (a, b) => Number(a.dataset.index) - Number(b.dataset.index),
  );
  let current = 0;

  const show = (i: number) => {
    current = (i + tiles.length) % tiles.length;
    const img = tiles[current].querySelector('img')!;
    big.src = img.currentSrc || img.src;
    big.alt = img.alt;
  };

  tiles.forEach((t, i) =>
    t.addEventListener('click', () => {
      show(i);
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    }),
  );
  dialog.addEventListener('close', () => (document.documentElement.style.overflow = ''));
  dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });

  // swipe between photos
  let x0: number | null = null;
  dialog.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  dialog.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    x0 = null;
  });
</script>
