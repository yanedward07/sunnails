---
import Logo from './Logo.astro';
import { site } from '../data/site';
---
<footer class="footer">
  <div class="container footer__inner">
    <Logo size="lg" tagline />
    <p class="footer__tag">{site.tagline}</p>
    <a href="#book" class="btn">Book your glow</a>
    <p class="footer__small">© {new Date().getFullYear()} {site.name}. Made with warm light.</p>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(var(--bg), var(--blush));
    padding: var(--section) 0 calc(6.5rem + env(safe-area-inset-bottom));
    text-align: center;
  }
  .footer__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }
  .footer__tag {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--terracotta-deep);
  }
  .footer__small {
    margin-top: 2rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  @media (min-width: 900px) {
    .footer {
      padding-bottom: 3rem;
    }
  }
</style>
