---
import { site } from '../data/site';
const tel = site.phone.replace(/[^\d+]/g, '');
---
<div class="bar" data-bookbar>
  <a href={`tel:${tel}`} class="bar__call" aria-label={`Call ${site.name}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path
        fill="currentColor"
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
      ></path></svg
    >
  </a>
  <a href="#book" class="btn bar__book">Book now</a>
</div>

<style>
  .bar {
    position: fixed;
    left: 0.75rem;
    right: 0.75rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    gap: 0.5rem;
    padding: 0.4rem;
    border-radius: var(--pill);
    background: rgb(var(--ink-rgb) / 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 14px 30px -10px rgb(0 0 0 / 0.45);
    transform: translateY(160%);
    transition: transform 0.6s var(--ease);
  }
  .bar.is-visible {
    transform: none;
  }
  .bar__call {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--frost);
    color: var(--ink);
  }
  .bar__call svg {
    width: 22px;
  }
  .bar__book {
    flex: 1;
    min-height: 52px;
  }
  @media (min-width: 900px) {
    .bar {
      display: none;
    }
  }
</style>

<script>
  // show once the hero is scrolled past; hide while the booking section is on screen
  const bar = document.querySelector<HTMLElement>('[data-bookbar]')!;
  const hero = document.querySelector('#top');
  const book = document.querySelector('#book');
  let pastHero = false;
  let onBook = false;
  const sync = () => bar.classList.toggle('is-visible', pastHero && !onBook);

  if (hero) new IntersectionObserver(([e]) => ((pastHero = !e.isIntersecting), sync()), { threshold: 0.35 }).observe(hero);
  if (book) new IntersectionObserver(([e]) => ((onBook = e.isIntersecting), sync())).observe(book);
</script>
