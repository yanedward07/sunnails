---
// Wordmark logo: "Sun Nails" set in Instrument Serif, with the dot of the "i" drawn as a rising sun.
interface Props {
  size?: 'sm' | 'lg';
  tagline?: boolean;
}
const { size = 'sm', tagline = false } = Astro.props;
---
<span class={`logo logo--${size}`} role="img" aria-label="Sun Nails">
  <span class="logo__word" aria-hidden="true">
    Sun <em>Na<span class="logo__i">ı<svg class="logo__sun" viewBox="0 0 40 26">
          <g class="logo__rays" stroke="var(--aqua)" stroke-width="3" stroke-linecap="round">
            <path d="M20 2v5M6 8l3.5 3.5M34 8l-3.5 3.5M1 19h5M34 19h5"></path>
          </g>
          <path d="M9 24a11 11 0 0 1 22 0z" fill="var(--teal)"></path>
        </svg></span>ls</em>
  </span>
  {tagline && <span class="logo__tag" aria-hidden="true">nail spa · toronto</span>}
</span>

<style>
  .logo {
    display: inline-grid;
    justify-items: center;
    line-height: 1;
    color: inherit;
  }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.15rem;
    letter-spacing: -0.01em;
    padding-top: 0.5em;
  }
  .logo--lg .logo__word {
    font-size: clamp(3.4rem, 12vw, 6.5rem);
  }
  .logo__word em {
    font-style: italic;
    color: var(--teal);
  }
  .logo__i {
    position: relative;
  }
  /* the sun sits where the tittle of the i would be */
  .logo__sun {
    position: absolute;
    width: 0.34em;
    max-width: none;
    left: 50%;
    bottom: 0.88em;
    transform: translateX(-36%);
    overflow: visible;
  }
  .logo__rays {
    transform-origin: 20px 24px;
    transition: transform 0.8s var(--ease);
  }
  .logo:hover .logo__rays,
  a:hover > .logo .logo__rays {
    transform: rotate(16deg);
  }
  .logo__tag {
    margin-top: 0.7em;
    font-family: var(--font-body);
    font-size: clamp(0.7rem, 1.6vw, 0.9rem);
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-left: 0.32em;
  }
</style>
