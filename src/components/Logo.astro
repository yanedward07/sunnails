---
interface Props {
  size?: 'sm' | 'lg';
}
const { size = 'sm' } = Astro.props;
---
<span class={`logo logo--${size}`}>
  <svg class="logo__mark" viewBox="0 0 64 48" aria-hidden="true">
    <path d="M12 40a20 20 0 0 1 40 0z" fill="var(--apricot)"></path>
    <g class="logo__rays" stroke="var(--gold)" stroke-width="3.5" stroke-linecap="round">
      <path d="M32 6v6M15 13l4 4M49 13l-4 4M5 28h6M53 28h6"></path>
    </g>
    <path d="M8 44h48" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"></path>
  </svg>
  <span class="logo__word">Sun <em>Nails</em></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'opsz' 72;
    font-size: 1.6rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .logo--lg {
    font-size: clamp(2.6rem, 8vw, 4.5rem);
  }
  .logo__mark {
    width: 1.25em;
    height: auto;
    flex: none;
  }
  .logo__rays {
    transform-origin: 32px 40px;
    transition: transform 0.8s var(--ease);
  }
  .logo:hover .logo__rays {
    transform: rotate(18deg);
  }
  .logo__word em {
    font-style: italic;
    color: var(--terracotta);
  }
</style>
